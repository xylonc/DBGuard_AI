# Copy to .env.demo and set your own key. Never commit .env.demo.
OLLAMA_API_KEY=replace-with-your-ollama-cloud-key
HERMES_MODEL=gpt-oss:20b
HERMES_MODEL_BASE_URL=https://ollama.com/v1
# UI is this port. Six following ports are reserved for this demo.
DEMO_BASE_PORT=8443
# Used only by the host MCP bridge for the HERMES container.
# Docker Desktop / Linux host-gateway must be able to reach this binding.
DEMO_MCP_BIND=0.0.0.0
