# Use a unique local password. Do not commit the populated .env file.
DBGUARD_DB_PASSWORD=change-me
DATABASE_URL=postgresql://dbguard:change-me@localhost:5433/dbguard

# Choose one model provider.
OPENAI_API_KEY=
OLLAMA_API_KEY=
OLLAMA_API_BASE=https://ollama.com/api
OLLAMA_API_URL=https://ollama.com/api

# HERMES chat uses Ollama Cloud's OpenAI-compatible endpoint. The free plan
# includes starter usage. The API key above is injected only at runtime.
HERMES_MODEL=gpt-oss:20b
HERMES_MODEL_BASE_URL=https://ollama.com/v1

EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
LLM_MODEL=llama3.1

# HERMES exposes its OpenAI-compatible API only on localhost. Replace this
# development value before using the stack outside one developer machine.
HERMES_API_SERVER_KEY=change-me-hermes-local-key
HERMES_DASHBOARD_USERNAME=dbguard
HERMES_DASHBOARD_PASSWORD=change-me-hermes-dashboard-password
