{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dbguardai.local/schemas/assessment-report-v1.json",
  "title": "DBGuardAI assessment report schema (version 1)",
  "description": "Contract for assessment reports produced by the spec_engine.assess() function.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_version",
    "target",
    "inputs",
    "flags",
    "summary",
    "results"
  ],
  "properties": {
    "report_version": {
      "description": "Report schema version (always 1 for current format).",
      "type": "integer",
      "const": 1
    },
    "target": {
      "description": "Target database information.",
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "database", "server_major"],
      "properties": {
        "target_id": {
          "description": "Target identifier.",
          "type": "string",
          "minLength": 1
        },
        "database": {
          "description": "Database name.",
          "type": "string",
          "minLength": 1
        },
        "server_version": {
          "description": "Full server version string (e.g., 'PostgreSQL 17.0 on x86_64-pc-linux-gnu').",
          "type": ["string", "null"]
        },
        "server_major": {
          "description": "Server major version as integer (e.g., 17).",
          "type": ["integer", "null"]
        }
      }
    },
    "inputs": {
      "description": "Input metadata for reproducibility.",
      "type": "object",
      "additionalProperties": false,
      "required": ["collector_sha256", "manifest_sha256", "benchmark_id", "specs"],
      "properties": {
        "collector_sha256": {
          "description": "SHA-256 hash of the collector SQL file.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest_sha256": {
          "description": "SHA-256 hash of the manifest file.",
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "benchmark_id": {
          "description": "Benchmark identifier (e.g., 'cis-pg17-v1.1.0').",
          "type": ["string", "null"]
        },
        "specs": {
          "description": "List of specs that were assessed.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["spec_id", "spec_hash"],
            "properties": {
              "spec_id": {
                "description": "Spec identifier.",
                "type": "string",
                "minLength": 1
              },
              "spec_hash": {
                "description": "SHA-256 hash of the spec.",
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "policy_profile": {
          "description": "Present when a spec takes its expected value from a policy profile (check.expected_from: policy), or when an approved profile supplies a site-specific fix value (fixes) for a spec in the set. null means no profile was supplied; policy specs are then MANUAL with reason_code policy_missing.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["profile_id", "sha256", "approved_by", "approved_at", "approval_auth"],
              "properties": {
                "profile_id": { "description": "Profile identifier.", "type": "string", "minLength": 1 },
                "sha256": { "description": "SHA-256 of the profile file bytes.", "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "approved_by": { "description": "Named human approver, or null when unapproved (values are then never used).", "type": ["string", "null"], "minLength": 1 },
                "approved_at": { "description": "Approval date, or null when unapproved.", "type": ["string", "null"], "minLength": 1 },
                "approval_auth": { "description": "How the approval was authenticated. DEMO_NO_SIGN_IN: the approver typed a name; there is no sign-in, so approved_by is not an authenticated identity.", "const": "DEMO_NO_SIGN_IN" }
              }
            }
          ]
        }
      }
    },
    "flags": {
      "description": "Assessment flags and metadata.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version_mismatch", "check_count", "orphan_checks", "integrity_ok"],
      "properties": {
        "version_mismatch": {
          "description": "True if benchmark version doesn't match server version, false if it matches, null if unknown.",
          "type": ["boolean", "null"]
        },
        "check_count": {
          "description": "Check count statistics.",
          "type": "object",
          "additionalProperties": false,
          "required": ["declared", "actual", "matches"],
          "properties": {
            "declared": {
              "description": "Declared check count from manifest.",
              "type": ["integer", "null"],
              "minimum": 0
            },
            "actual": {
              "description": "Actual number of checks in snapshot.",
              "type": "integer",
              "minimum": 0
            },
            "matches": {
              "description": "True if declared equals actual.",
              "type": ["boolean", "null"]
            }
          }
        },
        "orphan_checks": {
          "description": "Sorted list of spec_ids in snapshot but not in specs.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "integrity_ok": {
          "description": "True if check count matches.",
          "type": "boolean"
        }
      }
    },
    "summary": {
      "description": "Counts of each result type.",
      "type": "object",
      "additionalProperties": false,
      "required": ["PASS", "FAIL", "MANUAL", "NEEDS_CAPABILITY", "NOT_APPLICABLE", "NOT_COLLECTED", "STALE", "ERROR"],
      "properties": {
        "PASS": {
          "description": "Count of PASS results.",
          "type": "integer",
          "minimum": 0
        },
        "FAIL": {
          "description": "Count of FAIL results.",
          "type": "integer",
          "minimum": 0
        },
        "MANUAL": {
          "description": "Count of MANUAL results (manual_checklist, parameterised without a policy check, or policy_missing).",
          "type": "integer",
          "minimum": 0
        },
        "NEEDS_CAPABILITY": {
          "description": "Count of NEEDS_CAPABILITY results (needs_capability tier).",
          "type": "integer",
          "minimum": 0
        },
        "NOT_APPLICABLE": {
          "description": "Count of NOT_APPLICABLE results (applies_when condition false on clean, current evidence).",
          "type": "integer",
          "minimum": 0
        },
        "NOT_COLLECTED": {
          "description": "Count of NOT_COLLECTED results.",
          "type": "integer",
          "minimum": 0
        },
        "STALE": {
          "description": "Count of STALE results (hash mismatch).",
          "type": "integer",
          "minimum": 0
        },
        "ERROR": {
          "description": "Count of ERROR results.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "results": {
      "description": "List of assessment results for each spec.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["spec_id", "title", "tier", "result", "reason_code"],
        "properties": {
          "spec_id": {
            "description": "Spec identifier.",
            "type": "string",
            "minLength": 1
          },
          "title": {
            "description": "Spec title.",
            "type": "string"
          },
          "tier": {
            "description": "Spec tier.",
            "type": "string",
            "enum": ["automated", "parameterised", "manual_checklist", "needs_capability"]
          },
          "result": {
            "description": "Assessment result.",
            "type": "string",
            "enum": ["PASS", "FAIL", "MANUAL", "NEEDS_CAPABILITY", "NOT_APPLICABLE", "NOT_COLLECTED", "STALE", "ERROR"]
          },
          "reason_code": {
            "description": "Short code explaining the result.",
            "type": "string",
            "enum": ["hash_mismatch", "no_entry", "status_not_collected", "status_error", "non_string_result", "operator_true", "operator_false", "operator_error", "tier_manual", "tier_needs_capability", "policy_missing", "condition_no_entry", "condition_hash_mismatch", "condition_status_not_collected", "condition_status_error", "condition_non_string_result", "condition_operator_error", "condition_false", "session_override", "condition_session_override", "redacted_secret_setting", "condition_redacted_secret_setting", "wrong_pg_major", "section_not_collected", "field_missing", "manual_review", "databases_not_covered", "empty_review_set", "unlimited_connections", "connection_limits_set", "archive_mode_off", "archive_destination_missing", "archive_destination_conflict", "archive_standby", "archive_latest_failed", "archive_stats_reset_recent", "archive_never_run", "archive_timestamp_missing", "archive_timestamp_after_collection", "archive_older_than_max_age", "archive_recent"]
          },
          "setting_name": {
            "description": "PostgreSQL setting name (specs with a check, when an entry was collected).",
            "type": "string",
            "minLength": 1
          },
          "operator": {
            "description": "Check operator; exactly the OPERATORS registry in backend/app/services/spec_engine/operators.py.",
            "type": "string",
            "enum": ["equals", "not_equals", "in", "not_in", "contains_items", "contains_escapes", "severity", "no_item_in"]
          },
          "direction": {
            "description": "severity operator only.",
            "type": "string",
            "enum": ["at_or_more_verbose", "at_or_less_verbose"]
          },
          "expected": {
            "description": "Expected value(s) for the check. For expected_from policy, present only when the approved profile has a value.",
            "type": ["string", "array"]
          },
          "expected_from": {
            "description": "'policy' when the expected value comes from the policy profile.",
            "type": "string",
            "enum": ["policy"]
          },
          "spec_hash": {
            "description": "SHA-256 hash of the spec.",
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "collected_spec_hash": {
            "description": "SHA-256 hash in the snapshot entry, or null if no entry.",
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "observed": {
            "description": "Observed result value when status is ok (only when status was ok).",
            "type": "string"
          },
          "condition": {
            "description": "The spec's applies_when condition, with the observed condition value when it was collected ok.",
            "type": "object",
            "additionalProperties": false,
            "required": ["setting_name", "operator", "expected"],
            "properties": {
              "setting_name": { "type": "string", "minLength": 1 },
              "operator": { "type": "string", "enum": ["equals", "not_equals", "in", "not_in", "contains_items", "contains_escapes", "severity", "no_item_in"] },
              "direction": { "type": "string", "enum": ["at_or_more_verbose", "at_or_less_verbose"] },
              "expected": { "type": ["string", "array"] },
              "observed": { "type": "string" }
            }
          },
          "evidence": {
            "description": "Catalog checks only: the rows the evaluator read, as names and attributes (never hashes, function bodies, policy expressions or archive_command text).",
            "type": "array",
            "items": { "type": "object" }
          },
          "notices": {
            "description": "Catalog checks only: fixed, reviewed notices for the recommendation, shown whatever the result (7.4: restore_test_reminder).",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "text"],
              "properties": {
                "code": { "enum": ["restore_test_reminder"] },
                "text": { "type": "string", "minLength": 1 }
              }
            }
          },
          "evidence_paths": {
            "description": "Catalog checks only: baseline paths the evaluator read.",
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "cis": {
            "description": "Present with explanation (always on catalog checks): the CIS recommendation from the spec ref.",
            "type": "object",
            "additionalProperties": false,
            "required": ["recommendation", "title"],
            "properties": {
              "recommendation": { "type": "string", "minLength": 1 },
              "title": { "type": "string" }
            }
          },
          "explanation": {
            "description": "Structured facts (never prose) for NOT_APPLICABLE, NOT_COLLECTED, STALE, ERROR and MANUAL policy_missing results, and for every catalog check (code equals reason_code), so the UI can explain them. Facts come only from the spec, the profile and the collected evidence.",
            "type": "object",
            "additionalProperties": false,
            "required": ["code"],
            "properties": {
              "code": { "enum": ["condition_false", "condition_unknown", "policy_missing", "not_collected", "stale_spec_hash", "collector_error", "unit_or_non_text_value", "uninterpretable_value", "session_override", "redacted_secret_setting", "wrong_pg_major", "section_not_collected", "field_missing", "manual_review", "databases_not_covered", "empty_review_set", "unlimited_connections", "connection_limits_set", "archive_mode_off", "archive_destination_missing", "archive_destination_conflict", "archive_standby", "archive_latest_failed", "archive_stats_reset_recent", "archive_never_run", "archive_timestamp_missing", "archive_timestamp_after_collection", "archive_older_than_max_age", "archive_recent"] },
              "cause": { "description": "condition_unknown only: the evidence problem with the condition setting.", "enum": ["not_collected", "stale_spec_hash", "collector_error", "unit_or_non_text_value", "uninterpretable_value", "session_override", "redacted_secret_setting"] },
              "case": { "description": "policy_missing only.", "enum": ["no_profile", "profile_unapproved", "no_value_for_spec"] },
              "profile_id": { "type": "string", "minLength": 1 },
              "evidence": { "description": "Which evidence is affected: the main check or the applies_when condition.", "enum": ["check", "condition"] },
              "setting_name": { "type": "string", "minLength": 1 },
              "operator": { "type": "string", "enum": ["equals", "not_equals", "in", "not_in", "contains_items", "contains_escapes", "severity", "no_item_in"] },
              "direction": { "type": "string", "enum": ["at_or_more_verbose", "at_or_less_verbose"] },
              "expected": { "type": ["string", "array"] },
              "actual": { "description": "Collected SHOW value.", "type": "string" },
              "condition_quote": { "description": "Verbatim CIS text stating the condition.", "type": "string" },
              "entry_status": { "enum": ["missing", "not_collected"] },
              "spec_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "collected_spec_hash": { "type": ["string", "null"] },
              "error": { "description": "Collector-reported error text.", "type": ["string", "null"] },
              "source": { "description": "session_override only: pg_settings.source of the setting in the collector's session (per role, database or session; null if not a string).", "type": ["string", "null"] },
              "section": { "description": "Catalog checks: the baseline section.", "type": "string", "minLength": 1 },
              "gap_reason": { "type": "string" },
              "field": { "type": "string", "minLength": 1 },
              "spec_pg_major": { "type": "integer" },
              "snapshot_pg_major": { "type": "integer" },
              "evidence_count": { "type": "integer", "minimum": 0 },
              "databases": { "type": "array", "items": { "type": "string" } },
              "sections_not_collected": { "type": "array", "items": { "type": "string" } },
              "role_count": { "type": "integer", "minimum": 0 },
              "archive_mode": { "type": "string" },
              "archived_count": { "type": "integer", "minimum": 0 },
              "failed_count": { "type": "integer", "minimum": 0 },
              "last_archived_time": { "type": ["string", "null"] },
              "last_failed_time": { "type": ["string", "null"] },
              "stats_reset": { "type": ["string", "null"] },
              "collected_at": { "type": "string" },
              "max_age_hours": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
