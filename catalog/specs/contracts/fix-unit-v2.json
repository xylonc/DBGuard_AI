{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dbguardai.local/schemas/fix-unit-v2.json",
  "title": "DBGuardAI fix unit contract (version 2): one per-object action",
  "description": "Wave 2a (F6). One per-object fix on one catalog object: a role attribute, login or connection limit; a function's SECURITY DEFINER flag or PUBLIC EXECUTE; or DML grants on a table. target, params and prior_state come only from collected evidence (and the approved policy profile for connection limits), re-derived server-side from the fix_id (services/sandbox_poc/object_fixes.py). apply and rollback are the statements rendered from the approved, hash-pinned template for fix_type, run in one transaction each. verify describes the object predicate checked in re-collected evidence. Setting fixes keep fix-unit-v1.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fix_id",
    "spec_id",
    "fix_type",
    "template_id",
    "template_version",
    "target",
    "params",
    "prior_state",
    "apply",
    "rollback",
    "verify",
    "requires"
  ],
  "properties": {
    "schema_version": {
      "const": "fix-unit-v2"
    },
    "fix_id": {
      "description": "fix-<CIS recommendation>-<fix_type>-<first 10 hex of sha256(canonical target JSON)>.",
      "type": "string",
      "pattern": "^fix-[0-9]+(?:\\.[0-9]+)*-(?:role_connection_limit|role_drop_attribute|role_nologin|function_security_invoker|function_revoke_public_execute|table_revoke_dml)-[0-9a-f]{10}$"
    },
    "spec_id": {
      "description": "The catalog spec this fix serves.",
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9.]+)+:[0-9]+(?:\\.[0-9]+)*$"
    },
    "fix_type": {
      "enum": [
        "role_connection_limit",
        "role_drop_attribute",
        "role_nologin",
        "function_security_invoker",
        "function_revoke_public_execute",
        "table_revoke_dml"
      ]
    },
    "template_id": {
      "description": "Approved registry name of the template; equals fix_type.",
      "enum": [
        "role_connection_limit",
        "role_drop_attribute",
        "role_nologin",
        "function_security_invoker",
        "function_revoke_public_execute",
        "table_revoke_dml"
      ]
    },
    "template_version": {
      "type": "integer",
      "minimum": 1
    },
    "target": {
      "description": "The one object changed, from evidence.",
      "type": "object"
    },
    "params": {
      "description": "Template parameters without action, derived from target and evidence (connection_limit from the approved profile).",
      "type": "object"
    },
    "prior_state": {
      "description": "The exact current values the fix changes, from evidence.",
      "type": "object"
    },
    "apply": {
      "type": "object"
    },
    "rollback": {
      "type": "object"
    },
    "verify": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predicate"
      ],
      "properties": {
        "predicate": {
          "description": "Plain description of the object predicate checked in re-collected evidence.",
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "requires": {
      "description": "Role, function and grant changes take effect at once; no reload or restart.",
      "const": "none"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "fix_type": {
            "const": "role_connection_limit"
          }
        },
        "required": [
          "fix_type"
        ]
      },
      "then": {
        "properties": {
          "template_id": {
            "const": "role_connection_limit"
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role"
            ],
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63
              }
            }
          },
          "params": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role_name",
              "connection_limit"
            ],
            "properties": {
              "role_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63
              },
              "connection_limit": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              }
            }
          },
          "prior_state": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rolconnlimit"
            ],
            "properties": {
              "rolconnlimit": {
                "type": "integer",
                "minimum": -1
              }
            }
          },
          "apply": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "statements",
              "transactional"
            ],
            "properties": {
              "statements": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^ALTER ROLE "
                }
              },
              "transactional": {
                "const": true
              }
            }
          },
          "rollback": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "statements",
              "transactional"
            ],
            "properties": {
              "statements": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^ALTER ROLE "
                }
              },
              "transactional": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
