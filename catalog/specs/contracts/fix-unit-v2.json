            "maxProperties": 1,
            "additionalProperties": false,
            "properties": {
              "rolsuper": {
                "const": true
              },
              "rolcreaterole": {
                "const": true
              },
              "rolcreatedb": {
                "const": true
              },
              "rolreplication": {
                "const": true
              },
              "rolbypassrls": {
                "const": true
              }
            }
          },
          "apply": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "statements",
              "transactional"
            ],
            "properties": {
              "statements": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^ALTER ROLE "
                }
              },
              "transactional": {
                "const": true
              }
            }
          },
          "rollback": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "statements",
              "transactional"
            ],
            "properties": {
              "statements": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^ALTER ROLE "
                }
              },
              "transactional": {
                "const": true
              }
            }
          }
        }
